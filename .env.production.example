# ==============================================================================
# VetPets ERP — Plantilla de Configuración para PRODUCCIÓN (Clase 15)
# ==============================================================================
# Instrucciones:
# 1. Copiar este archivo como '.env' en el servidor de producción.
# 2. Generar la clave con: php artisan key:generate
# 3. Completar las credenciales reales de base de datos, correo y dominio.
# 4. NUNCA subir el archivo '.env' real al repositorio Git.
# ==============================================================================

APP_NAME="VetPets ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://erp.vetpets.com.co

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Conexión a Base de Datos MySQL (Producción)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vetpets_erp
DB_USERNAME=vetpets_user
DB_PASSWORD=

# Sesiones Seguras por HTTPS
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Cache y Colas
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Correo Transaccional SMTP Real
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notificaciones@vetpets.com.co"
MAIL_FROM_NAME="${APP_NAME}"

# Parámetros del Negocio VetPets ERP (config/erp.php)
ERP_LOW_STOCK_THRESHOLD=5
ERP_DAILY_SUMMARY_AT=19:00
